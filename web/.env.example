# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local a GitHub.

# Neon PostgreSQL (Dashboard de Neon > Connection string). Usa la cadena con "sslmode=require".
DATABASE_URL= # keep Neon credentials secure: do not expose them to client-side code

DATABASE_URL=postgresql://neondb_owner:npg_REMy4GVtmF0H@ep-wild-glade-b44y3xfl-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Secreto para firmar JWT. Genera uno con:  openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_EXPIRES_IN=12h

# Cloudinary (Dashboard > Settings > API Keys). El API_SECRET solo vive en el servidor.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=biblioscorza/libros

# Usuario inicial (solo lo usa: npm run db:seed-admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_NOMBRE=Administrador
