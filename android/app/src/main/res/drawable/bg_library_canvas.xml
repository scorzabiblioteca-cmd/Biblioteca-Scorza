<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F8FAFC"
                android:centerColor="#F2F7F8"
                android:endColor="#EAF2F3"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_library_watermark"
        android:gravity="top|end"
        android:width="150dp"
        android:height="150dp" />
    <item
        android:drawable="@drawable/ic_library_watermark"
        android:gravity="bottom|start"
        android:width="210dp"
        android:height="210dp" />
</layer-list>
