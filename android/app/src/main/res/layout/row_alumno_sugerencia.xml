<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="56dp" android:orientation="vertical" android:padding="10dp">
    <TextView android:id="@+id/tvNombreAlumno" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#17324D"
        android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvIdentificadorAlumno" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="3dp"
        android:textColor="#475569" android:textSize="13sp" />
</LinearLayout>
