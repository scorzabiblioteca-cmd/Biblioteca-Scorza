<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center_vertical" android:orientation="vertical" android:padding="24dp">
    <TextView style="@style/BsTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BiblioScorza" />
    <TextView style="@style/BsText" android:text="Ingresa con tu usuario de biblioteca" />
    <EditText android:id="@+id/etUsuario" style="@style/BsInput" android:hint="Usuario" android:inputType="text" android:autofillHints="username" />
    <EditText android:id="@+id/etClave" style="@style/BsInput" android:hint="Contraseña" android:inputType="textPassword" android:autofillHints="password" />
    <TextView android:id="@+id/tvError" style="@style/BsText" android:textColor="#B91C1C" />
    <Button android:id="@+id/btnIngresar" style="@style/BsButton" android:text="Ingresar" />
</LinearLayout>
