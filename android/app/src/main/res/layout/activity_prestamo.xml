<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView style="@style/BsTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nuevo préstamo" />
        <EditText android:id="@+id/etAlumno" style="@style/BsInput" android:hint="DNI o código del alumno" android:inputType="text" />
        <Button android:id="@+id/btnBuscarAlumno" style="@style/BsButton" android:text="Buscar alumno" />
        <Button android:id="@+id/btnScanAlumno" style="@style/BsButtonOutline" android:text="Escanear QR del alumno" />
        <TextView android:id="@+id/tvAlumno" style="@style/BsText" android:textStyle="bold" />
        <Button android:id="@+id/btnScanLibro" style="@style/BsButton" android:text="Escanear libro (QR o ISBN)" android:enabled="false" />
        <TextView android:id="@+id/tvItems" style="@style/BsText" />
        <TextView android:id="@+id/tvMsg" style="@style/BsText" />
        <Button android:id="@+id/btnConfirmar" style="@style/BsButton" android:text="Confirmar préstamo" android:enabled="false" />
    </LinearLayout>
</ScrollView>
