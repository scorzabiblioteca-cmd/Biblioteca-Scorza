<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/input_bg" android:gravity="center_vertical"
    android:orientation="horizontal" android:padding="10dp">
    <ImageView android:id="@+id/ivPortada" android:layout_width="64dp"
        android:layout_height="88dp" android:contentDescription="Portada del libro"
        android:scaleType="centerCrop" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvTitulo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#17324D"
            android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvAutor" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="3dp"
            android:textColor="#1E293B" android:textSize="14sp" />
        <TextView android:id="@+id/tvDetalles" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="3dp"
            android:textColor="#475569" android:textSize="12sp" />
        <TextView android:id="@+id/tvStock" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="3dp"
            android:textColor="#17324D" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
