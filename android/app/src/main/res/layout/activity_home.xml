<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F3F7FA" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <include layout="@layout/header_brand" />
        <TextView style="@style/BsTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="Biblioteca" />
        <TextView android:id="@+id/tvUsuario" style="@style/BsText"
            android:layout_marginTop="2dp" android:textColor="#64748B" />
        <TextView style="@style/BsText" android:layout_marginTop="20dp"
            android:text="Operaciones principales" android:textColor="#475569" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnEscanearIsbn"
            style="@style/BsButton" android:text="Escanear ISBN (registro rápido)"
            app:icon="@drawable/ic_barcode" app:iconGravity="textStart"
            app:iconPadding="12dp" app:iconTint="#FFFFFF" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnEscanearEjemplar"
            style="@style/BsButton" android:text="Escanear ejemplar"
            app:icon="@drawable/ic_qr_code" app:iconGravity="textStart"
            app:iconPadding="12dp" app:iconTint="#FFFFFF" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnPrestamo"
            style="@style/BsButton" android:text="Préstamo"
            app:icon="@drawable/ic_book_out" app:iconGravity="textStart"
            app:iconPadding="12dp" app:iconTint="#FFFFFF" />
        <TextView style="@style/BsText" android:layout_marginTop="20dp"
            android:text="Otras acciones" android:textColor="#475569" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnRegistrar"
            style="@style/BsButtonOutline" android:text="Registrar libro"
            app:icon="@drawable/ic_book_add" app:iconGravity="textStart"
            app:iconPadding="12dp" app:iconTint="#17324D" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnDevolucion"
            style="@style/BsButtonOutline" android:text="Devolución"
            app:icon="@drawable/ic_book_return" app:iconGravity="textStart"
            app:iconPadding="12dp" app:iconTint="#17324D" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnBuscar"
            style="@style/BsButtonOutline" android:text="Buscar"
            app:icon="@drawable/ic_search" app:iconGravity="textStart"
            app:iconPadding="12dp" app:iconTint="#17324D" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSalir"
            style="@style/BsButtonQuiet" android:text="Cerrar sesión"
            app:icon="@drawable/ic_logout" app:iconGravity="textStart"
            app:iconPadding="8dp" app:iconTint="#64748B" />
    </LinearLayout>
</ScrollView>
