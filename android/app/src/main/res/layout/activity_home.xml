<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F7FA"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <include
                layout="@layout/header_brand"
                android:padding="14dp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#17324D"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Biblioteca"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Sistema de gestión bibliotecaria"
                    android:textColor="#D8E5EF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#29465F"
                    android:paddingStart="12dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="7dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Accesos principales"
            android:textColor="#17324D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Escaneo y gestión de ejemplares"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrar"
                style="@style/BsHomeTile"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="Registrar libro"
                android:textAlignment="center"
                android:maxLines="2"
                app:icon="@drawable/ic_home_book_add"
                app:iconGravity="textTop"
                app:iconPadding="10dp"
                app:iconSize="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEscanearIsbn"
                style="@style/BsHomeTile"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="Escanear ISBN&#10;(registro rápido)"
                android:textAlignment="center"
                android:maxLines="2"
                app:icon="@drawable/ic_home_isbn"
                app:iconGravity="textTop"
                app:iconPadding="8dp"
                app:iconSize="40dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEscanearEjemplar"
                style="@style/BsHomeTile"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="Escanear ejemplar"
                android:textAlignment="center"
                android:maxLines="2"
                app:icon="@drawable/ic_home_qr"
                app:iconGravity="textTop"
                app:iconPadding="10dp"
                app:iconSize="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrestamo"
                style="@style/BsHomeTile"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="Préstamo"
                android:textAlignment="center"
                android:maxLines="2"
                app:icon="@drawable/ic_home_loan"
                app:iconGravity="textTop"
                app:iconPadding="10dp"
                app:iconSize="40dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDevolucion"
                style="@style/BsHomeTile"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="Devolución"
                android:textAlignment="center"
                android:maxLines="2"
                app:icon="@drawable/ic_home_return"
                app:iconGravity="textTop"
                app:iconPadding="10dp"
                app:iconSize="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuscar"
                style="@style/BsHomeTile"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="Buscar"
                android:textAlignment="center"
                android:maxLines="2"
                app:icon="@drawable/ic_home_search"
                app:iconGravity="textTop"
                app:iconPadding="10dp"
                app:iconSize="40dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalir"
            style="@style/BsButtonQuiet"
            android:layout_marginTop="14dp"
            android:text="Cerrar sesión"
            app:icon="@drawable/ic_home_logout"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="24dp" />
    </LinearLayout>
</ScrollView>
