<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <include layout="@layout/header_brand" />

        <ImageView
            android:id="@+id/ivPortadaDetalle"
            android:layout_width="136dp"
            android:layout_height="176dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="Portada del libro"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_book_stack" />

        <TextView
            android:id="@+id/tvTituloDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#17324D"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAutoresDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#526A7D"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvInventarioDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#E8F4F3"
            android:padding="14dp"
            android:textColor="#17324D"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDatosDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="4dp"
            android:textColor="#334B5E"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
